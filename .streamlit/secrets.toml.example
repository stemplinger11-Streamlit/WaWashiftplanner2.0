# Vorlage fuer die Streamlit-Secrets.
#
# Lokal:        Kopie als .streamlit/secrets.toml anlegen und ausfuellen.
# Streamlit.io: Inhalt unter Settings -> Secrets einfuegen.
#
# ACHTUNG: Die ausgefuellte Datei enthaelt Zugangsdaten und darf NIEMALS
# ins Repository. Sie ist in .gitignore bereits ausgeschlossen.

# ===== ADMIN-ZUGANG =====
# Wird beim ersten Start angelegt, falls die E-Mail noch nicht existiert.
# Ohne diese beiden Werte wird bewusst KEIN Admin angelegt.
ADMIN_EMAIL = "admin@example.de"
ADMIN_PASSWORD = "hier-ein-starkes-passwort"

# Empfaenger fuer Admin-Benachrichtigungen (neue Buchung, Registrierung,
# Backup). Kann von ADMIN_EMAIL abweichen.
ADMIN_EMAIL_RECEIVER = "dienstplan@example.de"

# ===== E-MAIL-VERSAND (SMTP) =====
# Bei Gmail wird ein App-Passwort benoetigt, nicht das Kontopasswort:
# https://myaccount.google.com/apppasswords
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "absender@gmail.com"
SMTP_PASSWORD = "app-passwort-ohne-leerzeichen"

# ===== SMS ueber TWILIO (optional) =====
# Auf "false" setzen, wenn kein SMS-Versand gewuenscht ist.
ENABLE_SMS_REMINDER = "false"
TWILIO_ACCOUNT_SID = ""
TWILIO_AUTH_TOKEN = ""
# Muss im E.164-Format vorliegen, also mit fuehrendem Pluszeichen.
TWILIO_PHONE_NUMBER = "+49..."

# ===== FIREBASE / FIRESTORE =====
# Inhalt der Service-Account-JSON aus der Firebase Console:
# Projekteinstellungen -> Dienstkonten -> Neuen privaten Schluessel generieren
[firebase]
type = "service_account"
project_id = "dein-projekt-id"
private_key_id = "..."
# Zeilenumbrueche im Schluessel bleiben als \n stehen:
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "firebase-adminsdk-xxxxx@dein-projekt.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
universe_domain = "googleapis.com"
